# ── Licensed Product / Service ──

<http://data.openlinksw.com/oplweb/IdehenNetDA#this> a schema:WebAPI, schema:Service ;
    schema:name "Knowledge graph access via Idehen.NET"@en ;
    schema:applicationCategory "Data Access"@en ;
    schema:applicationSubCategory "ACL controlled knowledge graph access"@en ;
    schema:description "Knowledge graph hosted by Idehen.NET, explorable via the /sparql endpoint, providing access to Knowledge Graphs, a resolver, Linked Data URI generation, and a bridge to the LOD Cloud."@en ;
